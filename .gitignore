# macOS
.DS_Store

# Xcode 构建产物（本项目 -derivedDataPath 指向 build/）
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint

# XcodeGen 生成工程（由 project.yml 现场生成,克隆后运行 generate_project.sh）
*.xcodeproj/

# Xcode 用户状态（不随仓库走）
xcuserdata/

# Swift Package Manager（预留）
.swiftpm/
.build/
Package.resolved

# CocoaPods（预留）
Pods/

# 本地工具设置（不随仓库走）
.claude/settings.local.json
